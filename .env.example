# Copy to .env for local runs. In production these live in the Pipecat Cloud
# secret set named in pcc-deploy.toml.

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Only the key for the TTS provider selected in config/bot.toml is required.
# `pipecat cloud secrets set --file` rejects empty values, so leave unused keys commented out.
# DEEPGRAM_API_KEY above also covers Deepgram Flux TTS.
CARTESIA_API_KEY=

# Long-term learner memory (required while [memory] enabled = true in config/bot.toml).
MEM0_API_KEY=

# Comma-separated E.164 numbers allowed to call the coach.
ALLOWED_CALLERS=+15551234567
