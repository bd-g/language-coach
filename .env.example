# Copy to .env for local runs. In production these live in the Pipecat Cloud
# secret set named in pcc-deploy.toml.

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Only the key for the provider selected in config/bot.toml is required.
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Comma-separated E.164 numbers allowed to call the coach.
ALLOWED_CALLERS=+15551234567
